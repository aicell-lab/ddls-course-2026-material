# OS / editor
.DS_Store
.idea/
.vscode/

# Python / notebooks
__pycache__/
*.pyc
.ipynb_checkpoints/
.venv/
env/

# Data / large files (share via releases or external storage)
*.zip

# Secrets — NEVER commit. This repo is public.
.env
.env.local
*.key

# Agent workspace state. Codex drops a bare `.codex` file (not a directory) in
# whatever folder it is run from, so match both forms.
.svamp/
.codex
.codex/

# Teacher-only material — NOT for students. Local-only, never committed.
# Kept OUT of week-*/data/ so the data-owner agent, which inspects that folder,
# cannot read the generator or the answer key.
CLAUDE.md
*.teacher.*
week-*/teacher/

# Week datasets live in the Hypha artifact ddls-course/2026-weekN, not in git.
week-*/data/*.csv
